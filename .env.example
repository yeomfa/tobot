# Copy to `.env.local` and fill in from your Supabase project:
#   Project Settings > API Keys
#
# New projects issue a publishable key (sb_publishable_...). Older projects
# have a legacy `anon` JWT instead, under the "Legacy API Keys" tab; both work,
# and VITE_SUPABASE_ANON_KEY is still read if that is what you have.
#
# Leave these unset to run entirely on localStorage, with no account needed.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" once Google is enabled under Authentication > Providers.
VITE_SUPABASE_GOOGLE=false
